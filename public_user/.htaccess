Options -Indexes

<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
LimitRequestBody 268435456

<FilesMatch "\.(sql|md|ini|log|bak|dist)$">
  Require all denied
</FilesMatch>

<Files "composer.json">
  Require all denied
</Files>

<Files "composer.lock">
  Require all denied
</Files>

RedirectMatch 403 ^/docs/
